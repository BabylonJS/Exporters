createNode script -n "ikfkSnapScriptNode";
	rename -uid "27C304CA-473D-8978-6228-6294BD3A173A";
	setAttr ".b" -type "string" (
		"import pymel.core as pm\n\nclass IKFKSnapWindow(object):\n    def __init__(self):\n        window_name = \"trexSnapWindow\"\n        if pm.window(window_name, exists=True):\n            pm.deleteUI(window_name)\n        with pm.window(window_name, title=\"T-Rex IK/FK Snapping\") as self.window:\n            with pm.verticalLayout(ratios=[0,1,1], spacing=10):\n                self.namespaceMenu = pm.optionMenu(label=\"Namespace:\")\n                pm.menuItem(label=\":\")\n                for ns in pm.namespaceInfo(\":\", listOnlyNamespaces=True, recurse=True, absoluteName=True):\n                    if ns.endswith(\":UI\") or ns.endswith(\":shared\"):\n                        continue\n                    pm.menuItem(label=ns)\n                with pm.horizontalLayout(spacing=10):\n                    with pm.verticalLayout():\n                        self.leftArmFKButton = pm.button(label=\"Switch Left Arm To FK\", command=pm.Callback(self.left_arm_fk_snap))\n                        self.leftArmIKButton = pm.button(label=\"Switch Left Arm To IK\", command=pm.Callback(self.left_arm_ik_snap))\n"
		+ "                    with pm.verticalLayout():\n                        self.rightArmFKButton = pm.button(label=\"Switch Right Arm To FK\", command=pm.Callback(self.right_arm_fk_snap))\n                        self.rightArmIKButton = pm.button(label=\"Switch Right Arm To IK\", command=pm.Callback(self.right_arm_ik_snap))\n                with pm.horizontalLayout(spacing=10):\n                    with pm.verticalLayout():\n                        self.leftLegFKButton = pm.button(label=\"Switch Left Leg To FK\", command=pm.Callback(self.left_leg_fk_snap))\n                        self.leftLegIKButton = pm.button(label=\"Switch Left Leg To IK\", command=pm.Callback(self.left_leg_ik_snap))\n                    with pm.verticalLayout():\n                        self.rightLegFKButton = pm.button(label=\"Switch Right Leg To FK\", command=pm.Callback(self.right_leg_fk_snap))\n                        self.rightLegIKButton = pm.button(label=\"Switch Right Leg To IK\", command=pm.Callback(self.right_leg_ik_snap))\n    \n    def snap(self, obj, target):\n"
		+ "        obj = pm.PyNode(\"{}:{}\".format(self.namespace, obj))\n        target = pm.PyNode(\"{}:{}\".format(self.namespace, target))\n        obj.setTranslation(target.getTranslation(space='world'), space='world')\n        obj.setRotation(target.getRotation(space='world'), space='world')\n    \n    def copy_toes(self, obj, target):\n        obj = pm.PyNode(\"{}:{}\".format(self.namespace, obj))\n        target = pm.PyNode(\"{}:{}\".format(self.namespace, target))\n        obj.toeCurl.set(target.toeCurl.get())\n        obj.toeSpread.set(target.toeSpread.get())\n    \n    def get_node(self, obj):\n        return pm.PyNode(\"{}:{}\".format(self.namespace, obj))\n        \n    def select(self, *names):\n        pm.select([\"{}:{}\".format(self.namespace, x) for x in names])\n    \n    @property\n    def namespace(self):\n        return self.namespaceMenu.getValue()\n    \n    def left_arm_fk_snap(self):\n        self.snap(\"LeftArm_ctrl\", \"bn_LeftArm\")\n        self.snap(\"LeftForeArm_ctrl\", \"bn_LeftForeArm\")\n        self.snap(\"LeftHand_ctrl\", \"bn_LeftHand\")\n"
		+ "        pm.PyNode(\"{}:{}\".format(self.namespace, \"Supermover_ctrl\")).leftArmIKFK.set(0)\n        self.select(\"LeftArm_ctrl\", \"LeftForeArm_ctrl\", \"LeftHand_ctrl\", \"Supermover_ctrl.leftArmIKFK\")\n    \n    def left_arm_ik_snap(self):\n        self.snap(\"LeftElbowIK_ctrl\", \"LeftElbowIK_ctrl_snapTarget\")\n        self.snap(\"LeftHandIK_ctrl\", \"bn_LeftHand\")\n        self.get_node(\"LeftHandIK_ctrl\").elbowOffset.set(0)\n        pm.PyNode(\"{}:{}\".format(self.namespace, \"Supermover_ctrl\")).leftArmIKFK.set(1)\n        self.select(\"LeftElbowIK_ctrl\", \"LeftHandIK_ctrl\", \"Supermover_ctrl.leftArmIKFK\")\n    \n    def right_arm_fk_snap(self):\n        self.snap(\"RightArm_ctrl\", \"bn_RightArm\")\n        self.snap(\"RightForeArm_ctrl\", \"bn_RightForeArm\")\n        self.snap(\"RightHand_ctrl\", \"bn_RightHand\")\n        pm.PyNode(\"{}:{}\".format(self.namespace, \"Supermover_ctrl\")).rightArmIKFK.set(0)\n        self.select(\"RightArm_ctrl\", \"RightForeArm_ctrl\", \"RightHand_ctrl\", \"Supermover_ctrl.rightArmIKFK\")\n    \n    def right_arm_ik_snap(self):\n        self.snap(\"RightElbowIK_ctrl\", \"RightElbowIK_ctrl_snapTarget\")\n"
		+ "        self.snap(\"RightHandIK_ctrl\", \"bn_RightHand\")\n        self.get_node(\"RightHandIK_ctrl\").elbowOffset.set(0)\n        pm.PyNode(\"{}:{}\".format(self.namespace, \"Supermover_ctrl\")).rightArmIKFK.set(1)\n        self.select(\"RightElbowIK_ctrl\", \"RightHandIK_ctrl\", \"Supermover_ctrl.rightArmIKFK\")\n    \n    def left_leg_fk_snap(self):\n        self.snap(\"LeftUpLeg_ctrl\", \"bn_LeftUpLeg\")\n        self.snap(\"LeftLeg_ctrl\", \"bn_LeftLeg\")\n        self.snap(\"LeftFoot_ctrl\", \"bn_LeftFoot\")\n        self.snap(\"LeftBall_ctrl\", \"bn_LeftBall\")\n        self.copy_toes(\"LeftBall_ctrl\", \"LeftFootIK_ctrl\")\n        pm.PyNode(\"{}:{}\".format(self.namespace, \"Supermover_ctrl\")).leftLegIKFK.set(0)\n        self.select(\"LeftUpLeg_ctrl\", \"LeftLeg_ctrl\", \"LeftFoot_ctrl\", \"LeftBall_ctrl\", \"Supermover_ctrl.leftLegIKFK\")\n    \n    def left_leg_ik_snap(self):\n        self.snap(\"LeftKneeIK_ctrl\", \"LeftKneeIK_ctrl_snapTarget\")\n        self.snap(\"LeftFootIK_ctrl\", \"bn_LeftBall\")\n        self.snap(\"LeftAnkleIK_ctrl\", \"bn_LeftFoot\")\n        self.copy_toes(\"LeftFootIK_ctrl\", \"LeftBall_ctrl\")\n"
		+ "        self.get_node(\"LeftFootIK_ctrl\").kneeOffset.set(0)\n        self.get_node(\"LeftToeRoll_ctrl\").rotate.set((0,0,0))\n        pm.PyNode(\"{}:{}\".format(self.namespace, \"Supermover_ctrl\")).leftLegIKFK.set(1)\n        self.select(\"LeftKneeIK_ctrl\", \"LeftFootIK_ctrl\", \"LeftAnkleIK_ctrl\", \"Supermover_ctrl.leftLegIKFK\")\n    \n    def right_leg_fk_snap(self):\n        self.snap(\"RightUpLeg_ctrl\", \"bn_RightUpLeg\")\n        self.snap(\"RightLeg_ctrl\", \"bn_RightLeg\")\n        self.snap(\"RightFoot_ctrl\", \"bn_RightFoot\")\n        self.snap(\"RightBall_ctrl\", \"bn_RightBall\")\n        self.copy_toes(\"RightBall_ctrl\", \"RightFootIK_ctrl\")\n        pm.PyNode(\"{}:{}\".format(self.namespace, \"Supermover_ctrl\")).rightLegIKFK.set(0)\n        self.select(\"RightUpLeg_ctrl\", \"RightLeg_ctrl\", \"RightFoot_ctrl\", \"RightBall_ctrl\", \"Supermover_ctrl.rightLegIKFK\")\n    \n    def right_leg_ik_snap(self):\n        self.snap(\"RightKneeIK_ctrl\", \"RightKneeIK_ctrl_snapTarget\")\n        self.snap(\"RightFootIK_ctrl\", \"bn_RightBall\")\n        self.snap(\"RightAnkleIK_ctrl\", \"bn_RightFoot\")\n"
		+ "        self.copy_toes(\"RightFootIK_ctrl\", \"RightBall_ctrl\")\n        self.get_node(\"RightFootIK_ctrl\").kneeOffset.set(0)\n        self.get_node(\"RightToeRoll_ctrl\").rotate.set((0,0,0))\n        pm.PyNode(\"{}:{}\".format(self.namespace, \"Supermover_ctrl\")).rightLegIKFK.set(1)\n        self.select(\"RightKneeIK_ctrl\", \"RightFootIK_ctrl\", \"RightAnkleIK_ctrl\", \"Supermover_ctrl.rightLegIKFK\")");
	setAttr ".st" 2;
	setAttr ".stp" 1;
